{
  "name": "autos-colombia-sistema",
  "version": "2.0.1",
  "description": "Sistema de Gestión para Parqueadero Autos Colombia - Iteraciones 1 y 2 (mensualidad, usuarios y celdas) - PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/auth.test.js && npm run test:preparar && node --test tests/flujo.test.js && node --test tests/iteracion2.test.js",
    "test:it1": "npm run test:preparar && node --test tests/flujo.test.js",
    "test:it2": "npm run test:preparar && node --test tests/iteracion2.test.js",
    "bd:verificar": "node scripts/bd.js verificar",
    "bd:migrar": "node scripts/bd.js migrar",
    "bd:crear": "node scripts/bd.js crear",
    "admin:crear": "node scripts/crear-admin.js",
    "usuario:credenciales": "node scripts/crear-credenciales.js",
    "test:preparar": "node scripts/preparar-pruebas.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=18"
  }
}
