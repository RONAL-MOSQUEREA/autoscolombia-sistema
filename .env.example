PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña
DB_NAME=autoscolombiadb
# Base aislada y exclusiva para pruebas automatizadas (no uses la base real).
DB_TEST_NAME=autoscolombiadb_test
# Zona horaria con la que la BD calcula "hoy" (vencimiento de mensualidades)
DB_TIMEZONE=America/Bogota

# Secreto compartido con el Sistema de Pago. Si se define, POST /api/pagos/confirmacion
# exige el encabezado "x-webhook-secret". La confirmación manual desde la interfaz requiere sesión de Administrador.
PAGO_WEBHOOK_SECRET=
# Cookies de sesión: true cuando el sistema se sirve exclusivamente por HTTPS
COOKIE_SECURE=false
